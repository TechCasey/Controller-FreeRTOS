              <FileType>1</FileType>
              <FilePath>..\Application\hardware\bsp_pwm.c</FilePath>
            </File>
            <File>
              <FileName>bsp_adc.c</FileName>
              <FileType>1</FileType>
              <FilePath>..\Application\hardware\bsp_adc.c</FilePath>
            </File>
            <File>
              <FileName>bsp_fmc.c</FileName>
              <FileType>1</FileType>
              <FilePath>..\Application\hardware\bsp_fmc.c</FilePath>
            </File>
            <File>
              <FileName>bsp_i2c.c</FileName>
              <FileType>1</FileType>
              <FilePath>..\Application\hardware\bsp_i2c.c</FilePath>
            </File>
            <File>
              <FileName>bsp_fwdtg.c</FileName>
              <FileType>1</FileType>
              <FilePath>..\Application\hardware\bsp_fwdtg.c</FilePath>
            </File>
            <File>
              <FileName>w25qxx.c</FileName>
              <FileType>1</FileType>
              <FilePath>..\Application\hardware\w25qxx.c</FilePath>
            </File>
            <File>
              <FileName>eeprom.c</FileName>
              <FileType>1</FileType>
              <FilePath>..\Application\hardware\eeprom.c</FilePath>
            </File>
            <File>
              <FileName>radar.c</FileName>
              <FileType>1</FileType>
              <FilePath>..\Application\hardware\radar.c</FilePath>
            </File>
            <File>
              <FileName>system_param.c</FileName>
              <FileType>1</FileType>
              <FilePath>..\Application\hardware\system_param.c</FilePath>
            </File>
          </Files>
        </Group>
        <!-- FreeRTOS Kernel Group -->
        <Group>
          <GroupName>FreeRTOS/Source</GroupName>
          <Files>
            <File>
              <FileName>tasks.c</FileName>
              <FileType>1</FileType>
              <FilePath>..\Middlewares\FreeRTOS\Source\tasks.c</FilePath>
            </File>
            <File>
              <FileName>queue.c</FileName>
