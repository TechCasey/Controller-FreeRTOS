              <FilePath>..\Middlewares\FreeRTOS\Source\queue.c</FilePath>
            </File>
            <File>
              <FileName>timers.c</FileName>
              <FileType>1</FileType>
              <FilePath>..\Middlewares\FreeRTOS\Source\timers.c</FilePath>
            </File>
            <File>
              <FileName>list.c</FileName>
              <FileType>1</FileType>
              <FilePath>..\Middlewares\FreeRTOS\Source\list.c</FilePath>
            </File>
            <File>
              <FileName>event_groups.c</FileName>
              <FileType>1</FileType>
              <FilePath>..\Middlewares\FreeRTOS\Source\event_groups.c</FilePath>
            </File>
            <File>
              <FileName>croutine.c</FileName>
              <FileType>1</FileType>
              <FilePath>..\Middlewares\FreeRTOS\Source\croutine.c</FilePath>
            </File>
            <File>
              <FileName>port.c</FileName>
              <FileType>1</FileType>
              <FilePath>..\Middlewares\FreeRTOS\Source\portable\GCC\ARM_CM33_NTZ\non_secure\port.c</FilePath>
            </File>
            <File>
              <FileName>heap_4.c</FileName>
              <FileType>1</FileType>
              <FilePath>..\Middlewares\FreeRTOS\Source\portable\MemMang\heap_4.c</FilePath>
            </File>
          </Files>
        </Group>
        <!-- GD32 Driver Group -->
        <Group>
          <GroupName>Drivers/GD32</GroupName>
          <Files>
            <File>
              <FileName>system_gd32a50x.c</FileName>
              <FileType>1</FileType>
              <FilePath>..\Drivers\CMSIS\GD\GD32A50x\Source\IAR\system_gd32a50x.c</FilePath>
            </File>
          </Files>
        </Group>
        <!-- SEGGER RTT Group -->
        <Group>
          <GroupName>SEGGER_RTT</GroupName>
          <Files>
            <File>
              <FileName>SEGGER_RTT.c</FileName>
              <FileType>1</FileType>
              <FilePath>..\Middlewares\SEGGER_RTT\SEGGER_RTT.c</FilePath>
            </File>
            <File>
              <FileName>SEGGER_RTT_printf.c</FileName>
              <FileType>1</FileType>
              <FilePath>..\Middlewares\SEGGER_RTT\SEGGER_RTT_printf.c</FilePath>
