<?xml version="1.0" encoding="UTF-8" standalone="no" ?>
<Project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="project_projx.xsd">

  <SchemaVersion>2.1</SchemaVersion>

  <Header>### uVision Project, (C) Keil Software</Header>

  <Targets>
    <Target>
      <TargetName>FreeRTOS_Project_Model</TargetName>
      <ToolsetNumber>0x4</ToolsetNumber>
      <ToolsetName>ARM</ToolsetName>
      <TargetOption>
        <TargetCommonOption>
          <Device>GD32A50x</Device>
          <Vendor>GigaDevice Semiconductor</Vendor>
          <PackID>GigaDevice.GD32A5xx_DFP.1.0.0</PackID>
          <PackURL>http://www.gigadevice.com</PackURL>
          <Cpu>IRAM(0x20000000,0x00010000) IROM(0x08000000,0x00080000) CPUTYPE("Cortex-M33") FPU2 VECTAB(0x20000000) CLOCK(12000000) ELITTLE</Cpu>
          <FlashDownload>1</FlashDownload>
          <RamSize>0x10000</RamSize>
          <RomSize>0x80000</RomSize>
        </TargetCommonOption>
        <CommonProperty>
          <UseGlobalSettingsOfToolchain>1</UseGlobalSettingsOfToolchain>
          <GlobalDriver>STLink</GlobalDriver>
          <WinPE>Yes</WinPE>
        </CommonProperty>
        <DebugOption>
          <SetRegEntry>
            <EnableFlashLoading>1</EnableFlashLoading>
          </SetRegEntry>
        </DebugOption>
        <Utilities>
          <Flash1>GD32A5xx GD MCU</Flash1>
          <Flash2>
            <Extensions>*.bin</Extensions>
            <忽</Flash2>
        </Utilities>
        <TargetArmAds>
          <Cads>
            <interw>1</interw>
            <Optimize>1</Optimize>
            <oTim>1</oTim>
            <oNOuc>1</oNOuc>
            <oIB>1</oIB>
            <oIC>1</oIC>
            <oEF>1</oEF>
            <oUud>1</oUud>
            <oBPU>1</oBPU>
            <IKEep>1</IKEep>
            <IEPort>1</IEPort>
            <IEOpSel>1</IEOpSel>
            <IEOpOpt>1</IEOpOpt>
            <Mx11>0</Mx11>
            <Ma10>0</Ma10>
            <Ma08>0</Ma08>
            <RxDP>0x08000000</RxDP>
            <Rx2DP>0x08000000</Rx2DP>
            <RamDP>0x20000000</RamDP>
            <Ram2DP>0x20000000</Ram2DP>
            <Cads>
              < Various>0</Various>
              <Ansi>1</Ansi>
              <Roads>1</Roads>
              <土木>1</土木>
              <EFpu>1</EFpu>
              <PPu>1</PPu>
            </Cads>
            <Aads>
              <disg>1</disg>
              <Ansy>1</Ansy>
            </Aads>
          </Cads>
        </TargetArmAds>
      </TargetOption>
      <Groups>
        <!-- USER Group -->
        <Group>
          <GroupName>USER</GroupName>
          <Files>
            <File>
              <FileName>main.c</FileName>
              <FileType>1</FileType>
              <FilePath>..\USER\Src\main.c</FilePath>
            </File>
            <File>
              <FileName>FreeRTOSPerfect.c</FileName>
              <FileType>1</FileType>
              <FilePath>..\USER\Src\FreeRTOSPerfect.c</FilePath>
            </File>
            <File>
              <FileName>gd32a50x_it.c</FileName>
              <FileType>1</FileType>
              <FilePath>..\USER\Src\gd32a50x_it.c</FilePath>
            </File>
            <File>
              <FileName>osbasetimer.c</FileName>
              <FileType>1</FileType>
              <FilePath>..\USER\Src\osbasetimer.c</FilePath>
            </File>
            <File>
              <FileName>systick.c</FileName>
              <FileType>1</FileType>
              <FilePath>..\USER\Src\systick.c</FilePath>
            </File>
          </Files>
        </Group>
        <!-- Application Group -->
        <Group>
          <GroupName>Application</GroupName>
          <Files>
            <File>
              <FileName>simple_example.c</FileName>
              <FileType>1</FileType>
              <FilePath>..\Application\app\simple_example.c</FilePath>
            </File>
            <File>
              <FileName>CanComm.c</FileName>
              <FileType>1</FileType>
              <FilePath>..\Application\app\CanComm.c</FilePath>
            </File>
            <File>
              <FileName>debug.c</FileName>
              <FileType>1</FileType>
              <FilePath>..\Application\app\debug.c</FilePath>
            </File>
            <File>
              <FileName>upgrade.c</FileName>
              <FileType>1</FileType>
              <FilePath>..\Application\app\upgrade.c</FilePath>
            </File>
          </Files>
        </Group>
        <!-- Hardware BSP Group -->
        <Group>
          <GroupName>BSP</GroupName>
          <Files>
            <File>
              <FileName>bsp_can.c</FileName>
              <FileType>1</FileType>
              <FilePath>..\Application\hardware\bsp_can.c</FilePath>
